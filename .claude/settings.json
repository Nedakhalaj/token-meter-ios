{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcrun xcresulttool:*)",
      "Bash(xcode-select -p)",
      "Bash(maestro:*)",
      "Bash(/Users/neda/.maestro/bin/maestro:*)",
      "Bash(plutil:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./**/Secrets.swift)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/*.env)"
    ]
  }
}
